# data.gov.sg — realtime API. Works without a key at 6 requests/10s; a
# Production key raises that to 30. The unauthenticated tier is past its own
# deprecation deadline (Dec 2025), so treat the key as required in production.
DATAGOV_API_KEY=

# OneMap — location search. As of Jul 2026 search returns an authentication
# error alongside results without a token, so this is effectively required.
# Prefer email+password over a pasted ONEMAP_TOKEN: tokens last ~3 days, so a
# pasted one works today and silently fails by the weekend.
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# Where state lives. MUST be outside the app tree and has no fallback — a
# default inside the tree lets the app boot, create an empty directory and
# serve nothing while reporting healthy.
DATA_DIR=/home/deploy/rain-sg-data
